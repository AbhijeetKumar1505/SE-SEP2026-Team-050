# Copy to .env and fill in what you need. .env is not committed.
# Nothing here is required for local development: the defaults use SQLite and print emails.

# development | testing | production
FLASK_CONFIG=development

# Required in production, at least 32 bytes. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Defaults to SECRET_KEY when empty.
JWT_SECRET_KEY=
JWT_ACCESS_HOURS=8

# Defaults to SQLite in instance/mentoring.db. Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/mentoring
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Where the web app runs, for the links in emails.
FRONTEND_URL=http://localhost:5173

# Email. Leave MAIL_SUPPRESS_SEND=true until a provider is chosen (decided with hosting).
# To catch emails locally in Mailpit (inbox at http://localhost:8025; scripts/wsl/setup.sh sets this up):
#   MAIL_SUPPRESS_SEND=false, MAIL_SERVER=127.0.0.1, MAIL_PORT=1025, MAIL_USE_TLS=false
MAIL_SUPPRESS_SEND=true
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=IITM BS Mentoring <no-reply@example.com>
# true prints every SMTP exchange, email body included, to the log. Off by default.
MAIL_DEBUG=false

LOG_LEVEL=INFO
